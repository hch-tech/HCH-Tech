    <!-- JavaScript Logic -->
    <script>
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile drawer toggle
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        menuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

        // Category Filter
        function filterExams(category) {
            const cards = document.querySelectorAll('.exam-card');
            const buttons = document.querySelectorAll('.tab-btn');

            buttons.forEach(btn => btn.classList.replace('bg-cyan-500', 'glass-card'));
            buttons.forEach(btn => btn.classList.replace('text-slate-950', 'text-slate-300'));
            event.currentTarget.classList.replace('glass-card', 'bg-cyan-500');
            event.currentTarget.classList.replace('text-slate-300', 'text-slate-950');

            cards.forEach(card => {
                if(category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Mock Test Simulation Questions Engine
        const sampleQuestions = [
            {
                q: "Which element has the highest thermal conductivity among metals?",
                options: ["Gold", "Silver", "Copper", "Aluminum"],
                answer: 1
            },
            {
                q: "In the context of Indian Polity, which Article deals with the Equality of Opportunity in Public Employment?",
                options: ["Article 14", "Article 15", "Article 16", "Article 19"],
                answer: 2
            },
            {
                q: "A train running at a speed of 72 km/h crosses a 200m long platform in 22 seconds. What is the length of the train?",
                options: ["220 m", "240 m", "200 m", "180 m"],
                answer: 1
            },
            {
                q: "Which CPU scheduling algorithm is non-preemptive in computer science OS architectures?",
                options: ["Round Robin", "First-Come, First-Served (FCFS)", "Shortest Remaining Time First", "Priority Scheduling (Preemptive)"],
                answer: 1
            },
            {
                q: "The Cabinet Mission arrived in India in which year?",
                options: ["1942", "1945", "1946", "1947"],
                answer: 2
            }
        ];

        let currentQIndex = 0;
        let userAnswers = [null, null, null, null, null];
        let markedForReviewState = [false, false, false, false, false];
        let timerInterval;

        function launchMockTest(title, durationMinutes) {
            document.getElementById('simTestTitle').textContent = title;
            document.getElementById('simBody').classList.remove('hidden');
            document.getElementById('simBody').classList.add('flex');
            document.getElementById('simResult').classList.add('hidden');
            document.getElementById('simResult').classList.remove('flex');
            
            // Reset state
            currentQIndex = 0;
            userAnswers = [null, null, null, null, null];
            markedForReviewState = [false, false, false, false, false];

            // Start timer
            let totalSeconds = durationMinutes * 60;
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                let m = Math.floor(totalSeconds / 60);
                let s = totalSeconds % 60;
                document.getElementById('simTimer').textContent = `${m < 10 ? '0'+m : m}:${s < 10 ? '0'+s : s}`;
                if(totalSeconds <= 0) {
                    clearInterval(timerInterval);
                    submitTest();
                }
                totalSeconds--;
            }, 1000);

            renderQuestion();
            renderPalette();

            document.getElementById('cbtSimModal').classList.remove('hidden');
            document.getElementById('cbtSimModal').classList.add('flex');
        }

        function renderQuestion() {
            const qData = sampleQuestions[currentQIndex];
            document.getElementById('simQNumber').textContent = `Question ${currentQIndex + 1} of 5`;
            document.getElementById('simQuestionText').textContent = qData.q;

            const optsContainer = document.getElementById('simOptionsContainer');
            optsContainer.innerHTML = '';

            qData.options.forEach((opt, idx) => {
                const isSelected = userAnswers[currentQIndex] === idx;
                const optBtn = document.createElement('button');
                optBtn.className = `w-full text-left p-4 rounded-xl border transition text-xs font-semibold flex items-center gap-3 ${isSelected ? 'bg-cyan-500/20 border-cyan-400 text-white' : 'glass-card border-slate-800 text-slate-300 hover:border-slate-700'}`;
                optBtn.innerHTML = `
                    <span class="w-6 h-6 rounded-full border flex items-center justify-center text-[10px] ${isSelected ? 'border-cyan-400 bg-cyan-400 text-slate-950 font-bold' : 'border-slate-600 text-slate-400'}">${String.fromCharCode(65 + idx)}</span>
                    <span>${opt}</span>
                `;
                optBtn.onclick = () => selectOption(idx);
                optsContainer.appendChild(optBtn);
            });
        }

        function selectOption(idx) {
            userAnswers[currentQIndex] = idx;
            renderQuestion();
            renderPalette();
        }

        function clearResponse() {
            userAnswers[currentQIndex] = null;
            renderQuestion();
            renderPalette();
        }

        function markForReview() {
            markedForReviewState[currentQIndex] = !markedForReviewState[currentQIndex];
            renderPalette();
        }

        function saveAndNext() {
            if(currentQIndex < sampleQuestions.length - 1) {
                currentQIndex++;
                renderQuestion();
                renderPalette();
            }
        }

        function renderPalette() {
            const palette = document.getElementById('simPalette');
            palette.innerHTML = '';

            for(let i = 0; i < 5; i++) {
                const btn = document.createElement('button');
                let bgClass = 'bg-slate-800 text-slate-400';

                if(markedForReviewState[i]) {
                    bgClass = 'bg-purple-600 text-white font-bold';
                } else if(userAnswers[i] !== null) {
                    bgClass = 'bg-emerald-500 text-slate-950 font-bold';
                }

                if(i === currentQIndex) {
                    bgClass += ' ring-2 ring-cyan-400';
                }

                btn.className = `h-10 rounded-xl flex items-center justify-center text-xs transition ${bgClass}`;
                btn.textContent = i + 1;
                btn.onclick = () => {
                    currentQIndex = i;
                    renderQuestion();
                    renderPalette();
                };
                palette.appendChild(btn);
            }
        }

        function submitTest() {
            clearInterval(timerInterval);
            let score = 0;
            let attempted = 0;

            userAnswers.forEach((ans, idx) => {
                if(ans !== null) {
                    attempted++;
                    if(ans === sampleQuestions[idx].answer) {
                        score += 2;
                    }
                }
            });

            document.getElementById('simBody').classList.add('hidden');
            document.getElementById('simBody').classList.remove('flex');
            document.getElementById('simResult').classList.remove('hidden');
            document.getElementById('simResult').classList.add('flex');

            document.getElementById('resScore').textContent = `${score} / 10`;
            document.getElementById('resAccuracy').textContent = attempted > 0 ? `${Math.round((score / (attempted * 2)) * 100)}%` : '0%';
            document.getElementById('resAttempted').textContent = `${attempted} / 5`;
        }

        function closeCbtSimulation() {
            clearInterval(timerInterval);
            document.getElementById('cbtSimModal').classList.add('hidden');
            document.getElementById('cbtSimModal').classList.remove('flex');
        }
    </script>
